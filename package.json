{
	"name": "n8n-nodes-xberg-pdf-vlm-extractor",
	"version": "0.1.0",
	"description": "n8n community node to OCR PDFs with a Vision Language Model and extract structured fields, powered by xberg",
	"license": "MIT",
	"homepage": "",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"ocr",
		"pdf",
		"vlm",
		"xberg"
	],
	"author": {
		"name": "Michael Wittmann"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/michaelwittmann/n8n-nodes-xberg-pdf-vlm-extractor.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/XbergVlmApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/PdfVlmExtractor/PdfVlmExtractor.node.js"
		]
	},
	"dependencies": {
		"@xberg-io/xberg": "^1.3.10"
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"eslint": "9.32.0",
		"prettier": "3.6.2",
		"release-it": "^21.1.0",
		"typescript": "5.9.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	},
	"engines": {
		"node": ">=22"
	}
}
