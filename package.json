{
	"name": "n8n-nodes-xberg-pdf-vlm-extractor",
	"version": "0.1.0",
	"description": "n8n community node to OCR PDFs with a Vision Language Model and extract structured fields, powered by xberg",
	"license": "MIT",
	"homepage": "https://github.com/michaelwittmann/n8n-nodes-xberg-pdf-vlm-extractor",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"ocr",
		"pdf",
		"vlm",
		"xberg"
	],
	"author": {
		"name": "Michael Wittmann",
		"email": "michael.wittmann@tum.de"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/michaelwittmann/n8n-nodes-xberg-pdf-vlm-extractor.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": false,
		"nodes": [
			"dist/nodes/PdfOcr/PdfOcr.node.js",
			"dist/nodes/PdfFieldExtractor/PdfFieldExtractor.node.js"
		]
	},
	"dependencies": {
		"@xberg-io/xberg": "^1.3.10",
		"pdf-lib": "^1.17.1"
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"@vitest/coverage-v8": "^5.0.5",
		"eslint": "9.32.0",
		"prettier": "3.6.2",
		"release-it": "^21.1.0",
		"typescript": "5.9.2",
		"vitest": "^5.0.5"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	},
	"engines": {
		"node": ">=24"
	}
}
